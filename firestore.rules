rules_version = '2';

// REGRAS DE SEGURANÇA DO FIRESTORE
//
// Até agora o banco estava em modo aberto: qualquer pessoa com a URL lia e
// apagava tudo. Isso bastava enquanto só existia uma mesa de amigos, mas o
// Arquivo de Veneza pede documentos liberados para um jogador específico — e
// segredo que só o navegador esconde não é segredo. Quem souber abrir o
// console vê todos eles.
//
// O desenho aqui resolve isso sem servidor, usando uma propriedade das regras:
// get() e exists() rodam no servidor e enxergam documentos que o cliente NÃO
// pode ler. É isso que permite guardar a senha da mesa num lugar invisível e
// ainda assim conferi-la na entrada.
//
// Estrutura:
//   campaigns/{cid}                  → público para quem está logado (nome, tema, sistema)
//   campaigns/{cid}/privado/acesso   → senhaHash. NINGUÉM lê. Só as regras consultam.
//   campaigns/{cid}/membros/{uid}    → quem entrou e com que papel
//   c__{cid}__*                      → todos os dados da mesa, só para membros dela
//
// Publicar: firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    // ───────────────────────────────────────────────────────────────────
    // Auxiliares
    // ───────────────────────────────────────────────────────────────────

    function logado() {
      return request.auth != null;
    }

    function membro(cid) {
      return logado()
        && exists(/databases/$(database)/documents/campaigns/$(cid)/membros/$(request.auth.uid));
    }

    // .get('papel', '') e não .papel: ler um campo que não existe não devolve
    // vazio, derruba a avaliação inteira da regra. E como mestre(cid) é o
    // primeiro termo de vários "ou", um registro de membro sem papel — de
    // alguma versão antiga — negaria tudo, inclusive pelos caminhos que nem
    // dependem de ser Mestre.
    function papel(cid) {
      return get(/databases/$(database)/documents/campaigns/$(cid)/membros/$(request.auth.uid)).data.get('papel', '');
    }

    function mestre(cid) {
      return membro(cid) && papel(cid) == 'mestre';
    }

    // As senhas da mesa, lidas de um lugar que o cliente não alcança.
    //
    // O exists() não é zelo: get() num documento que não existe derruba a
    // avaliação inteira da regra, e o efeito disso em produção foi uma mesa
    // onde ninguém além do criador conseguia entrar — a senha certa era
    // recusada sem explicação, porque o documento das senhas nunca tinha
    // sido escrito.
    function temAcesso(cid) {
      return exists(/databases/$(database)/documents/campaigns/$(cid)/privado/acesso);
    }
    function senhaDaMesa(cid) {
      return temAcesso(cid)
        ? get(/databases/$(database)/documents/campaigns/$(cid)/privado/acesso).data.get('senhaHash', '')
        : '';
    }
    function senhaDeMestre(cid) {
      return temAcesso(cid)
        ? get(/databases/$(database)/documents/campaigns/$(cid)/privado/acesso).data.get('senhaMestreHash', '')
        : '';
    }

    // MESA SEM PORTA.
    //
    // Uma mesa pode não ter senha nenhuma — é o estado em que ela nasce,
    // antes de o Mestre definir uma. A tela sempre tratou isso como "entra
    // quem quiser", e durante um tempo o servidor tratou como "não entra
    // ninguém": as portas de senha abaixo exigiam um resumo não vazio. O
    // resultado era a pior combinação possível. A pessoa entrava pela tela,
    // nenhum registro de membro era gravado, e dali em diante o servidor
    // negava cada leitura em silêncio — mesa montada, tudo vazio.
    //
    // Agora o servidor concorda com a tela: mesa sem senha admite qualquer
    // pessoa logada, como jogador. Exige-se que as DUAS senhas estejam
    // vazias, a pública e a privada, para que uma mesa cujas senhas ainda
    // não migraram para privado/acesso não seja confundida com mesa aberta.
    function mesaSemSenha(cid) {
      return senhaDaMesa(cid) == ''
        && get(/databases/$(database)/documents/campaigns/$(cid)).data.get('passwordHash', '') == '';
    }

    // O nome da coleção de uma campanha é "c__{id}__colecao". Daí sai o id.
    function idNaColecao(colecao) {
      return colecao.split('__')[1];
    }

    function colecaoDeCampanha(colecao) {
      return colecao.matches('c__[a-z0-9-]+__.+');
    }

    // ───────────────────────────────────────────────────────────────────
    // Contas
    // ───────────────────────────────────────────────────────────────────

    match /users/{uid} {
      // Cada pessoa lê e escreve só o próprio registro. Ninguém lista contas
      // alheias, nem para descobrir quem mais joga.
      allow read, write: if logado() && request.auth.uid == uid;
    }

    // ───────────────────────────────────────────────────────────────────
    // Mesas
    // ───────────────────────────────────────────────────────────────────

    // Quem criou a mesa. Vazio nas mesas feitas antes deste campo existir.
    function donoDaMesa(cid) {
      return get(/databases/$(database)/documents/campaigns/$(cid)).data.get('criadoPor', '');
    }
    function mesaSemDono(cid) {
      return donoDaMesa(cid) == '';
    }

    match /campaigns/{cid} {
      // A lista de mesas é visível para quem está logado: é preciso ver a
      // mesa para pedir para entrar nela. Nenhum dado de jogo mora aqui.
      allow read: if logado();

      // Criar exige dizer quem criou, e ninguém cria em nome de outro. É esse
      // campo que depois permite ao criador virar Admin da própria mesa sem
      // precisar de uma senha que ainda não existe.
      allow create: if logado() && request.resource.data.criadoPor == request.auth.uid;

      allow update: if mestre(cid);

      // APAGAR.
      //
      // Três portas, e a do meio existe porque a primeira falhava em
      // silêncio. mestre(cid) depende do registro de membro trazer papel de
      // Mestre; se esse registro não chegou a ser gravado — a criação da
      // mesa é uma sequência de escritas, e a última pode falhar sozinha —,
      // a pessoa ficava com uma mesa criada por ela que nem ela nem ninguém
      // conseguia remover. Era o caso das mesas de teste encalhadas.
      //
      // Quem está em criadoPor responde pela mesa, tenha registro de membro
      // ou não. É o campo mais confiável que existe aqui: é gravado no mesmo
      // ato de criação e as regras exigem que ele seja o próprio autor.
      //
      // A terceira porta é para as mesas feitas antes de existir criadoPor:
      // ninguém é dono delas, e sem isso ficariam na lista para sempre.
      allow delete: if mestre(cid)
        || (logado() && request.auth.uid == donoDaMesa(cid))
        || (logado() && mesaSemDono(cid));

      // A senha. Nenhum caminho de leitura, para ninguém, nunca. As regras
      // acima ainda a consultam por get(), que roda no servidor.
      match /privado/{doc} {
        allow read: if false;
        // Também o criador, e não só o Mestre: na hora de criar a mesa ele
        // ainda não é membro de nada, e é justamente aí que as senhas
        // precisam ser gravadas. Exigir ser Mestre aqui fecharia o mesmo nó
        // de antes, um passo adiante.
        allow write: if mestre(cid) || (logado() && request.auth.uid == donoDaMesa(cid));
      }

      match /membros/{uid} {
        // Três portas para virar membro, nesta ordem de confiança:
        //
        //  1. Quem criou a mesa entra como Admin dela. Sem isto, o criador
        //     ficava trancado para fora da própria campanha: as regras exigem
        //     ser membro para escrever qualquer coisa, e virar membro exigia
        //     uma senha que só o Admin pode definir. Era um nó fechado.
        //  2. Quem tem a senha da mesa entra como jogador. O cliente manda o
        //     hash; o servidor compara com o que está no lugar invisível.
        //  3. Mesa sem dono (feita antes do campo existir) pode ser assumida,
        //     senão ela fica órfã para sempre.
        //  4. Quem sabe a senha de MESTRE vira Mestre, com a mesma visão e o
        //     mesmo comando de quem criou a mesa. É o que a mesa espera: a
        //     senha de Mestre é passada de pessoa para pessoa, e quem a
        //     recebe assume a mesa. Antes ela só acendia um botão na tela,
        //     enquanto o servidor continuava vendo um jogador comum.
        //
        // Vale para create e para update do próprio registro, porque quem já
        // entrou como jogador precisa poder subir sem ser apagado antes. A
        // senha é reconferida em toda escrita: trocá-la derruba o acesso de
        // quem só tinha a antiga.
        allow create, update: if logado()
          && request.auth.uid == uid
          && request.resource.data.papel in ['jogador', 'mestre']
          && (
            request.auth.uid == donoDaMesa(cid)
            || mesaSemDono(cid)
            || (
              request.resource.data.papel == 'mestre'
              && senhaDeMestre(cid) != ''
              && request.resource.data.get('senhaHash', '') == senhaDeMestre(cid)
            )
            || (
              // A senha de entrada dá jogador, nunca Mestre. Sem este
              // "papel == 'jogador'", qualquer um que soubesse a senha da
              // mesa se declararia Mestre na própria escrita — a porta mais
              // larga do arquivo abrindo a sala mais estreita.
              request.resource.data.papel == 'jogador'
              && senhaDaMesa(cid) != ''
              && request.resource.data.get('senhaHash', '') == senhaDaMesa(cid)
            )
            || (
              // Mesa que ainda não tem senha: entra quem está logado, como
              // jogador. Definir a senha da mesa fecha esta porta na hora.
              request.resource.data.papel == 'jogador'
              && mesaSemSenha(cid)
            )
          );

        // Cada um vê a própria entrada; o Mestre vê a mesa toda.
        allow read: if logado() && (request.auth.uid == uid || mestre(cid));

        // Promover, rebaixar e remover é do Mestre. Ninguém se promove.
        allow update, delete: if mestre(cid);
      }
    }

    // ───────────────────────────────────────────────────────────────────
    // Os dados de cada mesa
    // ───────────────────────────────────────────────────────────────────

    // Teto de tamanho por documento.
    //
    // O Firestore já recusa acima de 1 MiB, mas aí o estrago é outro: alguém
    // com a conta aberta poderia encher a cota diária da mesa com documentos
    // enormes até o banco parar de responder para todo mundo. 400 KiB é folga
    // de sobra para uma ficha com retrato e aperta a porta do abuso.
    function tamanhoRazoavel() {
      return request.resource == null || request.resource.size() < 400 * 1024;
    }

    // COLEÇÕES DE ACESSO SELETIVO
    //
    // Estas não seguem a regra geral de "membro da mesa vê tudo da mesa":
    // nelas o Mestre decide, documento a documento, quem enxerga.
    //
    // E elas precisam ficar DE FORA da regra geral, não apenas ganhar uma
    // regra própria mais estreita. As regras do Firestore se somam: basta um
    // match autorizar para a operação passar. A primeira versão disto tinha
    // a regra estreita dos documentos ao lado da regra geral, e a geral já
    // liberava tudo para qualquer membro — então a restrição não restringia
    // nada. Era segredo de tela, exatamente o que ela existia para evitar.
    function acessoSeletivo(colecao) {
      return colecao.matches('c__[a-z0-9-]+__documentos')
        || colecao.matches('c__[a-z0-9-]+__mural_cartoes');
    }

    function daMesaComum(colecao) {
      return colecaoDeCampanha(colecao) && !acessoSeletivo(colecao);
    }

    match /{colecao}/{documento} {
      // Só membros da mesa entram nos dados dela. Isso cobre fichas, mapas,
      // crônicas, pecados — tudo que é escopado por campanha e aberto à mesa.
      allow read: if daMesaComum(colecao) && membro(idNaColecao(colecao));
      allow write: if daMesaComum(colecao) && membro(idNaColecao(colecao)) && tamanhoRazoavel();
    }

    match /{colecao}/{documento}/{resto=**} {
      allow read: if daMesaComum(colecao) && membro(idNaColecao(colecao));
      allow write: if daMesaComum(colecao) && membro(idNaColecao(colecao)) && tamanhoRazoavel();
    }

    // Documentos liberados por pessoa.
    //
    // Um documento guardado só chega a quem o Mestre liberou. Escrever é só
    // do Mestre: o documento é material dele.
    match /{colecao}/{documento} {
      allow read: if colecao.matches('c__[a-z0-9-]+__documentos')
        && membro(idNaColecao(colecao))
        && (
          mestre(idNaColecao(colecao))
          || resource.data.get('liberadoParaTodos', false) == true
          || request.auth.uid in resource.data.get('liberadoPara', [])
        );

      allow write: if colecao.matches('c__[a-z0-9-]+__documentos')
        && mestre(idNaColecao(colecao))
        && tamanhoRazoavel();
    }

    // Cartões do mural.
    //
    // Leitura funciona como a dos documentos, com uma diferença: cartão sem
    // campo de liberação é de antes desta regra, e esses continuam abertos.
    // Tratá-los como trancados faria o mural de toda mesa sumir para os
    // jogadores na primeira publicação.
    //
    // Escrever é de qualquer membro, e isso é de propósito: o mural é de
    // todos, jogador prega cartão, move e liga. O que só o Mestre muda é
    // QUEM VÊ — senão bastaria um jogador editar o próprio cartão trancado
    // para se liberar.
    match /{colecao}/{documento} {
      allow read: if colecao.matches('c__[a-z0-9-]+__mural_cartoes')
        && membro(idNaColecao(colecao))
        && (
          mestre(idNaColecao(colecao))
          || !('liberadoParaTodos' in resource.data)
          || resource.data.get('liberadoParaTodos', false) == true
          || request.auth.uid in resource.data.get('liberadoPara', [])
        );

      // Pregar: qualquer membro, com cartão aberto e assinado por ele.
      allow create: if colecao.matches('c__[a-z0-9-]+__mural_cartoes')
        && membro(idNaColecao(colecao))
        && tamanhoRazoavel()
        && (
          mestre(idNaColecao(colecao))
          || (
            request.resource.data.get('liberadoParaTodos', true) == true
            && request.resource.data.get('autor', '') == request.auth.uid
          )
        );

      // Reescrever e despregar: o que cada um pregou é de quem pregou.
      //
      // A exceção é mover. Arrastar o cartão do colega pela parede é como a
      // mesa trabalha — mudar o que ele escreveu, não. Por isso quem não é o
      // autor só passa se NADA além de x e y tiver mudado.
      //
      // Cartão sem autor é de antes desta regra e fica com o Admin: abrir
      // exceção para eles seria liberar justamente os mais antigos, que são
      // os que a investigação já construiu em cima.
      allow update: if colecao.matches('c__[a-z0-9-]+__mural_cartoes')
        && membro(idNaColecao(colecao))
        && tamanhoRazoavel()
        && (
          mestre(idNaColecao(colecao))
          || (
            resource.data.get('autor', '') == request.auth.uid
            && request.resource.data.get('liberadoParaTodos', true)
              == resource.data.get('liberadoParaTodos', true)
            && request.resource.data.get('liberadoPara', [])
              == resource.data.get('liberadoPara', [])
          )
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['x', 'y'])
        );

      allow delete: if colecao.matches('c__[a-z0-9-]+__mural_cartoes')
        && membro(idNaColecao(colecao))
        && (
          mestre(idNaColecao(colecao))
          || resource.data.get('autor', '') == request.auth.uid
        );
    }

    // ───────────────────────────────────────────────────────────────────
    // A Dinastia E, enquanto não migra
    // ───────────────────────────────────────────────────────────────────
    //
    // A mesa em andamento guarda seus dados em caminhos sem prefixo, de quando
    // o site tinha só uma campanha. Trancá-los agora derrubaria a mesa no meio
    // da campanha, e a regra é não arriscar dado nenhum.
    //
    // A primeira versão disto listava as coleções à mão — sheets, config,
    // battlemaps e mais cinco. Estava errada: o site usa 32, e as 26 que
    // faltavam (mapa de batalha, névoa, bestiário, dados públicos, páginas do
    // livro, mídias das crônicas) ficaram inacessíveis no instante em que as
    // regras subiram. Lista escrita à mão é um erro esperando a próxima
    // coleção nova.
    //
    // Então a regra foi invertida: é aberto tudo o que NÃO pertence a uma
    // campanha nova e NÃO é a lista de mesas nem a de contas. Assim qualquer
    // coleção da Dinastia E, inclusive as que ainda não existem, continua
    // funcionando sem ninguém precisar lembrar de vir aqui.
    //
    // Isso significa que a Dinastia E NÃO está protegida por estas regras.
    // É dívida conhecida, não descuido: migrar é mover as coleções para
    // c__dinastia-e__* e apagar este bloco, de preferência entre uma sessão
    // e outra.
    match /{colecao}/{documento=**} {
      allow read, write: if !colecao.matches('c__.*')
        && colecao != 'campaigns'
        && colecao != 'users';
    }
  }
}

// ──────────────────────────────────────────────────────────────────────
// DÍVIDA CONHECIDA: A SENHA DA FICHA NÃO É CONFERIDA AQUI
//
// Cada ficha pode ter uma senha, definida pelo Mestre. Ela deixou de ser
// guardada em texto puro — o documento guarda o resumo (SHA-256 com um sal
// por ficha) e o texto é descartado na hora. Isso resolveu o problema
// concreto que existia: a senha de cada jogador estava LEGÍVEL para todos
// os outros, porque as regras acima deixam todo membro ler toda ficha da
// mesa, e senha de mesa é senha reaproveitada.
//
// O que NÃO está resolvido: a conferência acontece no navegador. Quem abrir
// o console ainda consegue entrar numa ficha que não é dele. A senha segura
// a porta normal, não o invasor curioso com ferramentas.
//
// FECHAR ISSO DE VERDADE pede um mecanismo que hoje não existe: tomar posse
// de uma ficha não escreve nada no servidor — é estado do navegador
// (localStorage + o objeto de acesso). Enquanto a posse não for um
// documento, não há escrita para regra nenhuma julgar.
//
// O desenho que funcionaria, nos moldes já provados pela senha da mesa:
//
//   campaigns/{cid}/privado/fichas   → { <fichaId>: resumo }  ninguém lê
//   campaigns/{cid}/posse/{uid}      → { fichaId, senhaHash } só o dono lê
//
//   match /campaigns/{cid}/posse/{uid} {
//     allow create, update: if logado()
//       && request.auth.uid == uid
//       && request.resource.data.get('senhaHash','')
//          == senhaDaFicha(cid, request.resource.data.fichaId);
//     allow read: if request.auth.uid == uid || mestre(cid);
//   }
//
// A chave é o UID e não o id da ficha: assim o resumo guardado no documento
// é o da própria pessoa, que ela já conhece, e guardá-lo ali não vaza nada.
// É exatamente o truque que faz a senha da mesa funcionar em
// campaigns/{cid}/membros/{uid}.
//
// Mexer nisso significa mudar como o site escolhe a ficha do jogador, o que
// toca a entrada de TODAS as mesas — Dinastia E e Estrela de Absinto
// incluídas. Por isso está escrito aqui em vez de meio feito.
// ──────────────────────────────────────────────────────────────────────

